{
  "name": "monkey-king-dojo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A reference-matched architectural Three.js reconstruction of the Monkey King Dojo frontage.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check:assets": "node scripts/check-asset-budget.mjs",
    "build": "npm run check:assets && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/three": "^0.185.4",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
