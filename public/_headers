# Cloudflare Pages and Netlify read this file directly. More specific paths
# below replace the conservative document policy when the host merges matches.
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Content-hashed media and Vite bundles can be cached permanently.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/textures/*
  Cache-Control: public, max-age=31536000, immutable

/portfolio/*
  Cache-Control: public, max-age=31536000, immutable

/brands/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/content/dojo.json
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
